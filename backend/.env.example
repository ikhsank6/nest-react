# Environment
APP_ENV=local
APP_DEBUG=true
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:namamu@localhost:5432/postgres?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Email Configuration
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-mailtrap-user
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=noreply@yourapp.com
SUPPORT_EMAIL=support@yourapp.com

# Redis Configuration (for Bull Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:8080

# App Information (for email template)
APP_NAME=NestReact App
SUPPORT_EMAIL=support@yourapp.com

# Rate Limiting Configuration
THROTTLE_LOGIN_LIMIT=3
THROTTLE_LOGIN_TTL=60000